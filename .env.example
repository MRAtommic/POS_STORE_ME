# ==========================================
# POS Configuration File Example
# ==========================================

# พอร์ตเซิร์ฟเวอร์
PORT=3000

# ชื่อร้านและเบอร์พร้อมเพย์
SHOP_NAME=เครป ริมคลอง
PROMPTPAY_ID=0636534337

# อีเมลเจ้าของร้าน (Google Account) คั่นด้วยจุลภาคหากมีหลายคน
ADMIN_EMAILS=owner@example.com

# Google OAuth Client ID (จาก Google Cloud Console)
GOOGLE_CLIENT_ID=

# เปิดใช้งาน Trust Proxy
TRUST_PROXY=1

# โฟลเดอร์เก็บข้อมูล
DATA_DIR=./data
